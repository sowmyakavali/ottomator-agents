# Watson X.AI Configuration
# Get your Watson X.AI API Key from IBM Cloud Console
# https://cloud.ibm.com/apidocs/machine-learning

# Required: Your Watson X.AI API Key
WATSONX_API_KEY=your_watsonx_api_key_here

# Required: Your Watson X.AI Project ID
WATSONX_PROJECT_ID=your_project_id_here

# Optional: Watson X.AI URL (defaults to US South)
# Other regions: https://eu-de.ml.cloud.ibm.com, https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# The Watson X.AI model to use (defaults to granite-13b-chat-v2)
# Available models: ibm/granite-13b-chat-v2, ibm/granite-20b-multilingual, meta-llama/llama-2-70b-chat, etc.
WATSONX_MODEL=ibm/granite-13b-chat-v2